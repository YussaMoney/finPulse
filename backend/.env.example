MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: only allow requests from this site. If unset, any origin is allowed.
CORS_ORIGIN=http://localhost:5173
# Optional: database name (defaults to "finpulse"). Useful for a separate test database.
# MONGODB_DB=finpulse_test
